# Copy to .env and fill in. NEVER commit .env or put the key in browser code.
ENGINE_API_KEY=jsf_your_key_here
ENGINE_BASE_URL=https://www.jsflabs.io/api/v1
PORT=3000
# This email becomes admin when it registers (the very first account is also admin)
ADMIN_EMAIL=mainsaad276@gmail.com
# Where the database file is stored (use a persistent disk in production)
DATA_DIR=./data
NODE_ENV=development

# Vercel/Upstash (added automatically when you connect Upstash Redis in Vercel → Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
SESSION_SECRET=change-me-to-a-long-random-string
