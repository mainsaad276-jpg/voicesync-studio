<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launcher ("starting") theme. On API 31+ this is overridden in
         values-v31 with the real Android 12 SplashScreen APIs; below 31 it is
         a plain cream window with the brand mark so launch never flashes. -->
    <style name="Theme.VoiceSync.Starting" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
    </style>

    <!-- Post-splash theme applied in MainActivity.onCreate via setTheme(). -->
    <style name="Theme.VoiceSync" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green_dark</item>
        <item name="colorPrimaryDark">@color/brand_green_dark</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- The web UI ships its own light styling; never let the OS force-dark it. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
