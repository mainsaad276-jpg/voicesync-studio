<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for the live VoiceSync Studio web app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Mic for "Record My Voice" / voice cloning. Requested lazily at feature
         tap (see MainActivity.onPermissionRequest), never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Deliberately NOT declared: POST_NOTIFICATIONS, any storage permissions
         (MediaStore.Downloads needs none on API 29+; ACTION_GET_CONTENT needs
         none), READ_PHONE_STATE (call interruptions are handled via audio
         focus; see MainActivity). -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceSync.Starting"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Native JSF Labs API key / Voice ID settings screen, opened from the
             web app via VoiceSyncBridge.openJsfSettings(). Internal only. -->
        <activity
            android:name=".JsfSettingsActivity"
            android:exported="false"
            android:label="JSF Labs Settings"
            android:theme="@style/Theme.VoiceSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
