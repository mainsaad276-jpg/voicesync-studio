{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.js": { "maxDuration": 300, "includeFiles": "{public/**,config.js,lib/**}" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/v1/(.*)", "destination": "/api/index" },
    { "source": "/app", "destination": "/app.html" }
  ]
}
