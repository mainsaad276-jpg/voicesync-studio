{
  "appId": "pk.voicesync.studio",
  "appName": "VoxNova",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#1d5c4d",
      "showSpinner": false
    },
    "StatusBar": {
      "backgroundColor": "#1d5c4d",
      "style": "DARK",
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  }
}
